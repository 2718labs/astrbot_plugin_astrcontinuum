{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstrContinuum Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "snapshot_id",
    "session_key",
    "base_snapshot_id",
    "covered_event_end",
    "source_high_water_mark",
    "capsule_ids",
    "exact_anchor_ids",
    "rendered_context",
    "token_cost",
    "audit_outcome",
    "state",
    "created_at",
    "committed_at"
  ],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "session_key": {
      "$ref": "#/$defs/sessionKey"
    },
    "base_snapshot_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "covered_event_end": {
      "type": "integer",
      "minimum": 1
    },
    "source_high_water_mark": {
      "type": "integer",
      "minimum": 1
    },
    "capsule_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "exact_anchor_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rendered_context": {
      "type": "string",
      "minLength": 1
    },
    "token_cost": {
      "type": "integer",
      "minimum": 0
    },
    "audit_outcome": {
      "$ref": "#/$defs/auditOutcome"
    },
    "state": {
      "enum": [
        "CANDIDATE",
        "COMMITTED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "committed_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "COMMITTED"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "committed_at": {
            "type": "string",
            "format": "date-time"
          },
          "audit_outcome": {
            "properties": {
              "mechanical_passed": {
                "const": true
              },
              "semantic_status": {
                "enum": [
                  "NOT_RUN",
                  "PASSED"
                ]
              },
              "failure_codes": {
                "const": []
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "committed_at": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "sessionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_instance_id",
        "message_type",
        "session_id",
        "group_id",
        "user_id",
        "conversation_id",
        "persona_id"
      ],
      "properties": {
        "platform_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "message_type": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "group_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "persona_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "auditOutcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanical_passed",
        "semantic_status",
        "failure_codes"
      ],
      "properties": {
        "mechanical_passed": {
          "type": "boolean"
        },
        "semantic_status": {
          "enum": [
            "NOT_RUN",
            "PASSED",
            "FAILED"
          ]
        },
        "failure_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
