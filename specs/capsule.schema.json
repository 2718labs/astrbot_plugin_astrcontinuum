{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstrContinuum ContextCapsule",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capsule_id",
    "schema_version",
    "level",
    "session_key",
    "covered_event_start",
    "covered_event_end",
    "source_event_ids",
    "goals",
    "constraints",
    "decisions",
    "progress",
    "open_loops",
    "preferences",
    "entities",
    "emotional_context",
    "exact_anchors",
    "dependencies",
    "narrative_summary",
    "token_cost",
    "quality",
    "created_at"
  ],
  "properties": {
    "capsule_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "micro",
        "episode",
        "task",
        "global"
      ]
    },
    "session_key": {
      "$ref": "#/$defs/sessionKey"
    },
    "covered_event_start": {
      "type": "integer",
      "minimum": 1
    },
    "covered_event_end": {
      "type": "integer",
      "minimum": 1
    },
    "source_event_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "goals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "progress": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "open_loops": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "preferences": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "entities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "emotional_context": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "exact_anchors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "narrative_summary": {
      "type": "string",
      "minLength": 1
    },
    "token_cost": {
      "type": "integer",
      "minimum": 0
    },
    "quality": {
      "$ref": "#/$defs/quality"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "sessionKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform_instance_id",
        "message_type",
        "session_id",
        "group_id",
        "user_id",
        "conversation_id",
        "persona_id"
      ],
      "properties": {
        "platform_instance_id": {
          "type": "string",
          "minLength": 1
        },
        "message_type": {
          "type": "string",
          "minLength": 1
        },
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "group_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "user_id": {
          "type": "string",
          "minLength": 1
        },
        "conversation_id": {
          "type": "string",
          "minLength": 1
        },
        "persona_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "status",
        "confidence",
        "source_event_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "retracted",
            "uncertain"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "text",
        "status",
        "confidence",
        "source_event_ids",
        "rationale",
        "alternatives",
        "supersedes",
        "rejected_because"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "retracted",
            "uncertain"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rationale": {
          "type": "string"
        },
        "alternatives": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supersedes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rejected_because": {
          "type": "string"
        }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_id",
        "kind",
        "canonical_name",
        "aliases",
        "source_event_ids"
      ],
      "properties": {
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "canonical_name": {
          "type": "string",
          "minLength": 1
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchor_id",
        "anchor_type",
        "exact_text",
        "source_event_ids",
        "status",
        "importance"
      ],
      "properties": {
        "anchor_id": {
          "type": "string",
          "minLength": 1
        },
        "anchor_type": {
          "enum": [
            "name",
            "number",
            "date",
            "path",
            "url",
            "code",
            "formula",
            "prompt",
            "constraint",
            "commitment",
            "manual",
            "other"
          ]
        },
        "exact_text": {
          "type": "string",
          "minLength": 1
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "retracted"
          ]
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependency_id",
        "kind",
        "target_id",
        "source_event_ids"
      ],
      "properties": {
        "dependency_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanical_passed",
        "source_coverage",
        "anchor_recall",
        "unsupported_critical_claims",
        "coverage_gap"
      ],
      "properties": {
        "mechanical_passed": {
          "type": "boolean"
        },
        "source_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "anchor_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unsupported_critical_claims": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_gap": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
