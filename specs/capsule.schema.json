{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AstrContinuum ContextCapsule",
  "type": "object",
  "required": [
    "capsule_id",
    "level",
    "session_id",
    "covered_event_start",
    "covered_event_end",
    "claims",
    "decisions",
    "exact_anchors",
    "narrative_summary",
    "token_cost",
    "source_coverage"
  ],
  "properties": {
    "capsule_id": {
      "type": "string",
      "minLength": 1
    },
    "level": {
      "enum": [
        "micro",
        "episode",
        "task",
        "global"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "covered_event_start": {
      "type": "integer",
      "minimum": 1
    },
    "covered_event_end": {
      "type": "integer",
      "minimum": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/decision"
      }
    },
    "exact_anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "narrative_summary": {
      "type": "string"
    },
    "token_cost": {
      "type": "integer",
      "minimum": 0
    },
    "source_coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "claim_id",
        "kind",
        "text",
        "status",
        "confidence",
        "source_event_ids"
      ],
      "properties": {
        "claim_id": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "goal",
            "constraint",
            "progress",
            "open_loop",
            "preference",
            "entity",
            "emotional_context",
            "fact"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "retracted",
            "uncertain"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_event_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "decision": {
      "allOf": [
        {
          "$ref": "#/$defs/claim"
        },
        {
          "type": "object",
          "properties": {
            "rationale": {
              "type": "string"
            },
            "supersedes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "rejected_because": {
              "type": "string"
            }
          }
        }
      ]
    },
    "anchor": {
      "type": "object",
      "required": [
        "anchor_id",
        "anchor_type",
        "exact_text",
        "source_event_id",
        "status"
      ],
      "properties": {
        "anchor_id": {
          "type": "string"
        },
        "anchor_type": {
          "enum": [
            "name",
            "number",
            "date",
            "path",
            "url",
            "code",
            "formula",
            "prompt",
            "constraint",
            "commitment",
            "manual",
            "other"
          ]
        },
        "exact_text": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "superseded",
            "retracted"
          ]
        },
        "importance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}